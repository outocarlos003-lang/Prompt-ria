{
  "schema_version": "4.0",
  "operation": "integração da navegação neural, rastreabilidade de produção e integridade sistêmica",
  "demand": "Preservar integralmente o conteúdo existente e estabelecer uma única arquitetura operacional de navegação, pesquisa, conexão, origem, transformação, destino, referência, validação e resultado.",
  "source": {
    "repository": "outocarlos003-lang/Prompt-ria",
    "branch": "default",
    "root": "Promptária",
    "preserved": true,
    "existing_instruments": 10,
    "contract": "Promptária/manifest.json",
    "commit": "runtime_head"
  },
  "transformation": [
    "preservação dos 10 instrumentos existentes",
    "camada compartilhada Promptária/navegacao-neural.js aplicada ao núcleo e aos 10 instrumentos",
    "pesquisa transversal por título, caminho e conteúdo",
    "entradas, retornos, anterior e próximo derivados de Promptária/manifest.json",
    "validação de arestas contra a fonte única de verdade",
    "distinção entre diretório do instrumento e destino de produção"
  ],
  "destinations": [
    "index.html",
    "Promptária/Index.html",
    "Promptária/navegacao-neural.js",
    "Promptária/manifest.json",
    "Promptária/sitemap.xml",
    "Promptária/rastreabilidade-producao.json"
  ],
  "validation": {
    "mode": "fail_closed",
    "entrypoint": "Promptária/verificador-integridade.mjs",
    "workflow": ".github/workflows/promptaria-integrity.yml",
    "requires": [
      "manifest",
      "navigation_graph",
      "production_chain",
      "physical_identity",
      "internal_edges"
    ]
  },
  "production_chain": [
    "demanda",
    "instrumento responsável",
    "instrumentos participantes",
    "operação",
    "origem",
    "transformação",
    "arquivo/artefato",
    "destino",
    "referências",
    "validação",
    "resultado"
  ],
  "navigation_invariants": [
    "se existe conteúdo, existe caminho",
    "se existe caminho, existe destino",
    "se existe destino, existe retorno",
    "se existe relação, existe conexão",
    "cada instrumento possui entrada no núcleo",
    "cada instrumento possui retorno e continuidade anterior/próximo",
    "a pesquisa transversal alcança os 10 instrumentos"
  ],
  "networks": {
    "navigation": {
      "root": "Promptária/Index.html",
      "search": "Promptária/navegacao-neural.js",
      "graph": "Promptária/rede-navegacional.json"
    },
    "functional": {
      "manifest": "Promptária/manifest.json",
      "resolver": "Promptária/resolver-correferencia.mjs",
      "validator": "Promptária/verificador-integridade.mjs"
    },
    "production": {
      "trace": "Promptária/rastreabilidade-producao.json",
      "chain": [
        "demanda",
        "instrumento responsável",
        "instrumentos participantes",
        "operação",
        "origem",
        "transformação",
        "arquivo/artefato",
        "destino",
        "referências",
        "validação",
        "resultado"
      ]
    }
  },
  "invariants": [
    "todo conteúdo web catalogado ou explicitamente excluído por política",
    "todo nó navegacional possui entrada, destino e retorno",
    "todo caminho aponta para recurso existente",
    "todo resultado possui demanda e origem",
    "toda transformação possui instrumento responsável",
    "toda referência aponta para destino válido",
    "toda identidade ativável é fisicamente verificada",
    "ambiguidades bloqueiam ativação",
    "capacidades não ativam instrumentos",
    "Nocturna só é destino por determinação explícita ou inequívoca"
  ],
  "execution_trace": {
    "contract": "Promptária/rastreabilidade-producao.json",
    "trace_id": "required_per_execution",
    "id_policy": "unique_per_execution",
    "format": "TRACE-<timestamp>-<nonce>",
    "required_fields": [
      "trace_id",
      "demand_id",
      "manifest_sha256",
      "source_commit",
      "instrument_id",
      "instrument_title",
      "instrument_path",
      "content_sha256",
      "operation",
      "origin",
      "artifacts",
      "destination",
      "references",
      "validation",
      "result"
    ],
    "states": [
      "created",
      "resolved",
      "identity_verified",
      "recovered",
      "ready",
      "applied",
      "validated",
      "failed_closed"
    ],
    "fail_closed_rules": [
      "sem trace_id não há execução",
      "sem demand_id não há execução",
      "sem identidade física verificada não há execução",
      "sem content_sha256 não há execução",
      "sem origem ou destino determinado não há execução",
      "sem validação final não há resultado válido",
      "qualquer divergência entre trace e artefato invalida o resultado"
    ],
    "artifact_policy": {
      "track": [
        "created",
        "modified",
        "preserved",
        "removed"
      ],
      "every_artifact_requires_origin": true,
      "every_artifact_requires_destination": true
    }
  },
  "production_trace_contract": {
    "demand_to_result": "one_trace",
    "storage": "execution_bundle_or_external_append_only_store",
    "immutable_fields": [
      "trace_id",
      "demand_id",
      "manifest_sha256",
      "source_commit",
      "instrument_id",
      "content_sha256"
    ],
    "coordinated_operations": "participants_are_recorded_individually_under_the_same_trace_id",
    "nocturna": "destination_status_must_be_explicit_or_unequivocal"
  }
}
