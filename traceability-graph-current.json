  "relations": [
    {
      "id": "brand-to-home",
      "from": "ui.brand.name",
      "to": "#plataforma",
      "type": "navigation",
      "function": "retorno ao núcleo",
      "evidence": "index.html"
    },
    {
      "id": "hero-to-section",
      "from": "ui.hero.lead",
      "to": "ui.instrumentos.title",
      "type": "semantic",
      "function": "liga finalidade à descoberta",
      "evidence": "index.html"
    },
    {
      "id": "title-to-search",
      "from": "ui.instrumentos.title",
      "to": "ui.search.placeholder",
      "type": "label",
      "function": "rotula o controle de pesquisa",
      "evidence": "index.html aria-labelledby"
    },
    {
      "id": "search-to-registry",
      "from": "ui.search.placeholder",
      "to": "registry.instruments",
      "type": "functional",
      "function": "define o conjunto de instrumentos ativos carregados e filtrados pela interface",
      "evidence": "index.html: registryUrl aponta para config/instrument-registry.json; fetch(registryUrl) popula registry; validação em navegador ainda pendente"
    },
    {
      "id": "catalog-to-sources",
      "from": "catalog.instruments",
      "to": "instruments.sources",
      "type": "production",
      "function": "relaciona catálogo a fontes canônicas",
      "evidence": "config/instrument-catalog.json"
    },
    {
      "id": "visual-to-brand",
      "from": "ui.visual.core",
      "to": "ui.brand.symbol",
      "type": "identity",
      "function": "mantém símbolo central e marca coerentes",
      "evidence": "index.html"
    },
    {
      "id": "footer-to-entrypoint",
      "from": "ui.footer",
      "to": "index.html",
      "type": "source",
      "function": "vincula identificação ao entrypoint",
      "evidence": "index.html"
    },
    {
      "id": "registry-to-sources",
      "from": "registry.instruments",
      "to": "instruments.sources",
      "type": "reference",
      "function": "resolve os caminhos de origem dos instrumentos cadastrados",
      "evidence": "config/instrument-registry.json: campo path; verificação estrutural dos 10 caminhos realizada na branch"
    },
    {
      "id": "github-operational-to-recoverable",
      "from": "instrument.github-operational.continuous",
      "to": "instrument.github-operational.demand-mirror",
      "type": "phase_complementarity",
      "function": "interconecta a fase contínua e a versão espelho sem fundir identidades ou acionar automaticamente a fase recuperável",
      "evidence": "config/instrument-registry.json; config/recoverable-on-demand-catalog.json; config/instrument-execution-map.json"
    },
    {
      "id": "github-operational-demand-mirror-to-continuous",
      "from": "instrument.github-operational.demand-mirror",
      "to": "instrument.github-operational.continuous",
      "type": "reciprocal_traceability",
      "function": "mantém referência recíproca ao instrumento contínuo e preserva pertencimentos exclusivos",
      "evidence": "config/instrument-registry.json; config/recoverable-on-demand-catalog.json; config/instrument-execution-map.json"
    },
    {
      "id": "continuous-support-to-demand-mirror",
      "from": "instrument.github-operational.continuous-support",
      "to": "instrument.github-operational.demand-mirror",
      "type": "procedural_complementarity",
      "function": "a preparação contínua pode encaminhar a seleção explícita da versão espelho sem incluí-la no contexto contínuo",
      "evidence": "config/instrument-registry.json; config/instrument-execution-map.json"
    }
  ],
  "policy": {
    "every_node_requires_file_and_function": true,
    "every_relation_requires_evidence": true,
    "unverified_relations_must_not_be_declared_functional": true
  }
}
